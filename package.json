{
  "name": "snow-plugins",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "scripts": {
    "build": "bun build.mjs",
    "dev": "bun dev.mjs",
    "typecheck": "tsc --noEmit",
    "build:index": "bun build-index.mjs",
    "check:releases": "bun check-releases.mjs",
    "dev:repo": "bun dev-repo.mjs",
    "build:readme": "bun build-readme.mjs",
    "check:policy": "bun check-policy.mjs",
    "test": "bun run build && node --test tests/sdk.test.cjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "esbuild": "0.28.2",
    "@swc/core": "1.16.1",
    "hermes-compiler": "250829098.0.17",
    "react": "18.3.1"
  },
  "trustedDependencies": [
    "esbuild",
    "@swc/core"
  ],
  "dependencies": {
    "jpeg-js": "0.4.4",
    "pako": "1.0.11"
  }
}
